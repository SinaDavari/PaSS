+def is_point_on_floor(point_xy, floor_objects):
+    """
+    Check if a 2D point (X, Y) projected onto the floor plane lies within the Floor mesh boundary.
+    Uses ray casting from above the floor downward to check if the point is inside.
+    
+    Args:
+        point_xy: Vector or tuple with (x, y) coordinates
+        floor_objects: List of floor mesh objects
+    
+    Returns:
+        bool: True if point is within floor boundary, False otherwise
+    """
+    if not floor_objects:
+        return True  # If no floor, assume valid
+    
+    x, y = point_xy[0], point_xy[1]
+    
+    # Check each floor object
+    for floor_obj in floor_objects:
+        if floor_obj is None:
+            continue
+        if not hasattr(floor_obj, 'type') or floor_obj.type != 'MESH':
+            continue
+        if not hasattr(floor_obj, 'data') or floor_obj.data is None:
+            continue
+        if not hasattr(floor_obj.data, 'vertices') or not floor_obj.data.vertices:
+            continue
+        
+        try:
+            # Get the floor's bounding box to determine a safe height above the floor
+            floor_vertices = [floor_obj.matrix_world @ v.co for v in floor_obj.data.vertices]
+            if not floor_vertices:
+                continue
+            
+            # Get min and max Z of floor
+            floor_z_min = min(v.z for v in floor_vertices)
+            floor_z_max = max(v.z for v in floor_vertices)
+            
+            # Cast a ray from above the floor downward through the projected point
+            # Start from well above the floor
+            ray_start = Vector((x, y, floor_z_max + 10.0))
+            ray_end = Vector((x, y, floor_z_min - 10.0))
+            ray_direction = (ray_end - ray_start).normalized()
+            
+            # Convert to object space
+            ray_start_obj_space = floor_obj.matrix_world.inverted() @ ray_start
+            ray_direction_obj_space = floor_obj.matrix_world.inverted().to_3x3() @ ray_direction
+            
+            # Ray cast downward
+            result = floor_obj.ray_cast(ray_start_obj_space, ray_direction_obj_space)
+            if result[0]:  # Hit the floor mesh
+                # Check if the hit point's X,Y is close to our test point
+                hit_point_world = floor_obj.matrix_world @ result[1]
+                distance_xy = math.sqrt((hit_point_world.x - x)**2 + (hit_point_world.y - y)**2)
+                
+                # If the hit is close to our X,Y coordinates, the point is on the floor
+                if distance_xy < 0.1:  # Allow small tolerance
+                    return True
+        except Exception as e:
+            logger.warning(f'Error checking floor boundary for object {floor_obj.name if hasattr(floor_obj, "name") else "unknown"}: {str(e)}')
+            continue
+    
+    return False  # Point is not on any floor
+
+
+def get_scene_mesh_height():
+    """
+    Calculate the total height (min and max Z) of the scene mesh.
+    Excludes workers, horizon, floor, and helper objects.
+    
+    Returns:
+        tuple: (min_z, max_z, total_height) or (None, None, None) if no scene mesh found
+    """
+    scene_meshes = []
+    for obj in bpy.data.objects:
+        if obj is None:
+            continue
+        if not hasattr(obj, 'type') or obj.type != 'MESH':
+            continue
+        if not hasattr(obj, 'name') or obj.name is None:
+            continue
+        
+        obj_name = obj.name
+        # Check if object should be excluded
+        if ('Armature' in obj_name or 
+            'Horizon' in obj_name or 
+            'Floor' in obj_name or
+            'cam_circle' in obj_name or
+            'crv' in obj_name):
+            continue
+        
+        # Check parent
+        if obj.parent is not None:
+            if hasattr(obj.parent, 'name') and obj.parent.name is not None:
+                if 'Armature' in obj.parent.name:
+                    continue
+        
+        scene_meshes.append(obj)
+    
+    if not scene_meshes:
+        return None, None, None
+    
+    min_z = float('inf')
+    max_z = float('-inf')
+    
+    for obj in scene_meshes:
+        if obj is None or not hasattr(obj, 'data') or obj.data is None:
+            continue
+        if not hasattr(obj.data, 'vertices') or not obj.data.vertices:
+            continue
+        
+        try:
+            vertices = [obj.matrix_world @ v.co for v in obj.data.vertices]
+            if vertices:
+                obj_min_z = min(v.z for v in vertices)
+                obj_max_z = max(v.z for v in vertices)
+                min_z = min(min_z, obj_min_z)
+                max_z = max(max_z, obj_max_z)
+        except Exception as e:
+            logger.warning(f'Error processing mesh {obj.name if hasattr(obj, "name") else "unknown"}: {str(e)}')
+            continue
+    
+    if min_z == float('inf') or max_z == float('-inf'):
+        return None, None, None
+    
+    total_height = max_z - min_z
+    return min_z, max_z, total_height
+
